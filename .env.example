# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# NEON POSTGRESQL DATABASE CONFIGURATION
# =============================================================================
# Provide your Neon connection string (pooled endpoint recommended with sslmode=require)
# If omitted or unconfigured, the system automatically falls back to local JSON storage (data/database.json).
# Example: postgresql://neondb_owner:npg_secret123@ep-bold-glitter-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# =============================================================================
# CLOUDINARY MEDIA & ASSET STORAGE
# =============================================================================
# Configure your Cloudinary credentials for high-performance CDN image and video delivery.
# If omitted or unconfigured, the system automatically falls back to local disk storage (/uploads).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="goodfolk"

# Alternatively, you can use the single CLOUDINARY_URL format:
# CLOUDINARY_URL="cloudinary://my_key:my_secret@my_cloud_name"

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# Google Sheets webhook for forwarding public enquiry form submissions:
GOOGLE_SCRIPT_URL=""
